#!/usr/bin/env python3
"""Small localhost HTTP facade for the existing NeLisp Agent JSONL service.

The HTTP process owns network/authentication/resource limits.  The NeLisp
worker remains the single source of truth for JSONL validation and session
state.  Requests are serialized because one worker stream is stateful.
"""

import argparse
import json
import os
import secrets
import signal
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


DEFAULT_MAX_BODY = 1024 * 1024
DEFAULT_MAX_RESPONSE = 1024 * 1024
DEFAULT_TIMEOUT = 120.0
DEFAULT_MAX_REQUESTS = 1000


class WorkerProtocolError(RuntimeError):
    """The worker violated the one-line JSON response contract."""


class Worker:
    def __init__(self, command, timeout, max_requests, max_response):
        self.command = command
        self.timeout = timeout
        self.max_requests = max_requests
        self.max_response = max_response
        self.lock = threading.Lock()
        self.count = 0
        self.process = None

    def start(self):
        if self.process is not None:
            return
        self.process = subprocess.Popen(
            self.command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
            text=False,
            bufsize=-1,
        )

    def request(self, payload):
        with self.lock:
            if self.count >= self.max_requests:
                raise RuntimeError("request limit reached; restart the service")
            self.start()
            if self.process.poll() is not None:
                raise RuntimeError("agent worker is not running")
            self.count += 1
            try:
                request = (json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8")
                self.process.stdin.write(request)
                self.process.stdin.flush()
                # readline has no portable timeout.  A helper thread keeps the
                # HTTP handler bounded without changing the worker protocol.
                result = []
                error = []
                def read_line():
                    try:
                        result.append(self.process.stdout.readline(self.max_response + 1))
                    except Exception as exc:  # pragma: no cover - OS failure
                        error.append(exc)
                reader = threading.Thread(target=read_line, daemon=True)
                reader.start()
                reader.join(self.timeout)
                if reader.is_alive():
                    self.stop()
                    raise TimeoutError("agent worker response timed out")
                if error:
                    raise RuntimeError(str(error[0]))
                line = result[0] if result else b""
                if not line or len(line) > self.max_response or not line.endswith(b"\n"):
                    raise WorkerProtocolError("agent worker response exceeds the size limit")
                try:
                    return json.loads(line.decode("utf-8"))
                except (UnicodeError, json.JSONDecodeError) as exc:
                    raise WorkerProtocolError(
                        "agent worker returned invalid JSON") from exc
            except Exception:
                self.stop()
                raise

    def stop(self):
        process, self.process = self.process, None
        if process is None:
            return
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


class State:
    def __init__(self, token, worker, max_body):
        self.token = token
        self.worker = worker
        self.max_body = max_body


def make_handler(state):
    class Handler(BaseHTTPRequestHandler):
        server_version = "NeLispAgentHTTP/0.1"

        def log_message(self, fmt, *args):
            print("http: " + (fmt % args), file=sys.stderr)

        def send_json(self, status, value):
            body = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def authorized(self):
            supplied = self.headers.get("Authorization", "")
            if not supplied.startswith("Bearer "):
                return False
            return secrets.compare_digest(supplied[7:], state.token)

        def do_GET(self):
            if self.path != "/health":
                self.send_json(404, {"error": "not_found"})
                return
            self.send_json(200, {"ok": True, "service": "nelisp-agent"})

        def do_POST(self):
            if self.path != "/v1/jsonl":
                self.send_json(404, {"error": "not_found"})
                return
            if not self.authorized():
                self.send_json(401, {"error": "unauthorized"})
                return
            try:
                length = int(self.headers.get("Content-Length", "-1"))
            except ValueError:
                length = -1
            if length < 0 or length > state.max_body:
                self.send_json(413, {"error": "request_too_large"})
                return
            try:
                raw = self.rfile.read(length)
                payload = json.loads(raw.decode("utf-8"))
                if not isinstance(payload, dict):
                    raise ValueError("request must be a JSON object")
            except TimeoutError as exc:
                self.send_json(504, {"error": "worker_timeout", "message": str(exc)})
            except (ValueError, UnicodeError, json.JSONDecodeError) as exc:
                self.send_json(400, {"error": "invalid_json", "message": str(exc)})
                return
            try:
                response = state.worker.request(payload)
                self.send_json(200, response)
            except TimeoutError as exc:
                self.send_json(504, {"error": "worker_timeout", "message": str(exc)})
            except WorkerProtocolError as exc:
                self.send_json(502, {"error": "worker_failure", "message": str(exc)})
            except Exception as exc:
                self.send_json(502, {"error": "worker_failure", "message": str(exc)})

    return Handler


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--token-env", default="NELISP_AGENT_HTTP_TOKEN")
    parser.add_argument("--max-body", type=int, default=DEFAULT_MAX_BODY)
    parser.add_argument("--max-response", type=int, default=DEFAULT_MAX_RESPONSE)
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    parser.add_argument("--max-requests", type=int, default=DEFAULT_MAX_REQUESTS)
    parser.add_argument("--worker", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.host != "127.0.0.1":
        parser.error("HTTP facade is localhost-only; --host must be 127.0.0.1")
    if not args.token_env or not os.environ.get(args.token_env):
        parser.error("set a non-empty token environment variable before starting")
    if (args.max_body < 1 or args.max_response < 1 or args.timeout <= 0
            or args.max_requests < 1):
        parser.error("limits must be positive")
    worker = args.worker or [os.path.join(os.path.dirname(__file__), "nelisp-agent"),
                             "--jsonl", "--unattended"]
    if worker and worker[0] == "--":
        worker = worker[1:]
    if not worker:
        parser.error("worker command must not be empty")
    args.worker_command = worker
    return args


def main(argv=None):
    args = parse_args(argv)
    state = State(os.environ[args.token_env],
                  Worker(args.worker_command, args.timeout, args.max_requests,
                         args.max_response),
                  args.max_body)
    server = ThreadingHTTPServer((args.host, args.port), make_handler(state))
    def stop(_signal, _frame):
        # `shutdown` waits for `serve_forever` to leave its loop and therefore
        # must not be called directly from that loop's signal handler thread.
        threading.Thread(target=server.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        server.serve_forever()
    finally:
        state.worker.stop()
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

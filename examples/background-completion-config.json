{
  "format": "nl-agent-improvement-v1",
  "catalog": "../state/background-completion/models/catalog.json",
  "queueState": "../state/background-completion/improvement-queue.sexp",
  "providerId": "native",
  "providerName": "Completion-trained NeLisp models",
  "idPrefix": "self",

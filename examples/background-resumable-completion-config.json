{
  "format": "nl-agent-improvement-v1",
  "catalog": "../state/background-resumable-completion/models/catalog.json",
  "queueState": "../state/background-resumable-completion/improvement-queue.sexp",
  "providerId": "native",
  "providerName": "Resumable supervised NeLisp models",
  "idPrefix": "self-completion",
  "grammar": {"type": "message", "length": 128},
  "benchmark": {
    "examples": [" a"]
  },
  "model": {
    "source": "latest-or-new", "dim": 24, "ff": 48,
    "blocks": 2, "heads": 2, "maxParameters": 1000000
  },
  "training": {
    "objective": "completion",
    "execution": "background", "backend": "gpu",
    "sequence": 256, "optimizer": "adam",
    "checkpointEvery": 16,
    "checkpointDirectory": "../state/background-resumable-completion/recovery"
  },
  "minDelta": 0.0,
  "maxSequence": 1024,
  "maxPending": 32,
  "maxHistory": 256
}
